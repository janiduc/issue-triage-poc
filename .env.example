# Copy to .env (never commit the real file) and fill in what you use.

# --- AI model ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
SECRET_KEY=replace-with-a-long-random-string

# --- Issue tracker: simulated | github | jira | none ---
TRACKER=simulated
# Poll the tracker every N seconds (0 = only webhooks and the "Import now" button)
SYNC_INTERVAL_SECONDS=0

# GitHub Issues (fine-grained token: Issues read/write, Metadata read)
GITHUB_TOKEN=
GITHUB_REPO=owner/repository
GITHUB_WEBHOOK_SECRET=

# Jira Cloud (API token from id.atlassian.com)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=KEY
JIRA_WEBHOOK_SECRET=
