# Copy to .env (never commit the real file) and fill in what you use.

# --- AI model ---
# anthropic (paid API, needs ANTHROPIC_API_KEY) or ollama (free local model, see README)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Leave empty for the provider's default (claude-haiku-4-5-20251001, or qwen2.5:3b for Ollama)
LLM_MODEL=
# Ollama only: where it runs, and a longer timeout because laptop CPUs are slow
OLLAMA_URL=http://localhost:11434
LLM_TIMEOUT=
SECRET_KEY=replace-with-a-long-random-string

# --- Issue tracker: simulated | github | jira | none ---
TRACKER=simulated
# Poll the tracker every N seconds (0 = only webhooks and the "Import now" button)
SYNC_INTERVAL_SECONDS=0

# GitHub Issues (fine-grained token: Issues read/write, Metadata read)
GITHUB_TOKEN=
GITHUB_REPO=owner/repository
GITHUB_WEBHOOK_SECRET=

# Jira Cloud (API token from id.atlassian.com)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=KEY
JIRA_WEBHOOK_SECRET=
